{
  "rewrites": [
    { "source": "/menu", "destination": "/index.html" }
  ],
  "redirects": [
    { "source": "/menu/", "destination": "/menu", "permanent": true }
  ],
  "headers": [
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }] },
    { "source": "/app.js", "headers": [{ "key": "Cache-Control", "value": "public, max-age=300, stale-while-revalidate=604800" }] },
    { "source": "/layouts.js", "headers": [{ "key": "Cache-Control", "value": "public, max-age=300, stale-while-revalidate=604800" }] },
    { "source": "/menu.js", "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }] },
    { "source": "/config.js", "headers": [{ "key": "Cache-Control", "value": "public, max-age=300, stale-while-revalidate=604800" }] },
    { "source": "/styles.css", "headers": [{ "key": "Cache-Control", "value": "public, max-age=300, stale-while-revalidate=604800" }] }
  ]
}
